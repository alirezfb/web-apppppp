{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apppppp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1e50e4f9-fce3-415c-965e-944ffb0d87f0","database_name": "wweb-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a20cc564edaf459ca346d6d3cf5df7d5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
